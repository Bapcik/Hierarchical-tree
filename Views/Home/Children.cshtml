@model IEnumerable<testProject.Models.HierarchyModel>

@foreach (var node in Model)
{
    var allNodes = ViewData["AllNodes"] as IEnumerable<testProject.Models.HierarchyModel>;
    var children = allNodes?.Where(n => n.ParentId == node.Id).ToList();

    <li data-id="@node.Id" style="list-style:none; margin-bottom:4px;">
        <div class="d-flex align-items-center gap-2 p-2 border rounded">

            @if (children != null && children.Any())
            {
                <button class="btn btn-sm btn-outline-secondary toggle-btn" data-bs-toggle="collapse"
                        data-bs-target="#children-@node.Id" aria-expanded="true">
                </button>
            }
            else
            {
                <span style="width:28px; display:inline-block;"></span>
            }

            <span class="flex-grow-1">@node.Name</span>

            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" data-bs-toggle="modal" data-bs-target="#createModal">
                            Добавить
                        </a>
                    </li>

                    @if (node.ParentId != null)
                    {
                        <li>
                            <a class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editModal-@node.Id">
                                Редактировать
                            </a>
                        </li>

                        <li>
                            <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal"
                                    data-bs-target="#deleteModal-@node.Id">
                                Удалить
                            </button>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @if (children != null && children.Any())
        {
            <ul class="dd-list collapse show" id="children-@node.Id">
                @await Html.PartialAsync("Children", children, ViewData)
            </ul>
        }
    </li>
}